// Sprout 模型配置（JSONC：支持 // 和 /* */ 注释，以及尾逗号）。
// 终端界面里修改后几秒内自动重新读取；sprout run、sprout serve 和缺 API Key 启动时要重启才生效。
{
  // 默认使用的模型，格式为 "provider名/模型名"，两边都必须在下面定义过。
  "default": "deepseek/deepseek-flash",

  "providers": {
    "deepseek": {
      // 协议：openai-chat、openai-responses、anthropic-messages、google-generate。
      "protocol": "openai-chat",
      "baseUrl": "https://api.deepseek.com",
      // API Key 优先读环境变量 apiKeyEnv，环境变量没设置时才使用 apiKey。
      // 直接写 apiKey 时，请确保这个文件只在本机使用，不要提交到仓库。
      "apiKeyEnv": "DEEPSEEK_API_KEY",
      "apiKey": "",
      "models": {
        // contextWindow / maxOutput 可以不写：先查 sprout models update 下载的 models.dev 目录，
        // 查不到再用默认值（上下文 400000、输出 16000）。手写的值优先。
        // maxTokensParam 只对 openai-chat 有效：留空发 max_tokens，写 max_completion_tokens 发后者
        // （o 系列、GPT-5 这类模型在 Chat 协议下拒收 max_tokens）。
        "deepseek-flash": {
          "contextWindow": 1000000,
          "maxOutput": 384000,
          "tools": true,
          "vision": true,
          // 思考程度（/effort 切换）。没写 effort 的模型不能调节，也不会发送任何思考参数。
          // 每个档位写要发给服务端的值：字符串是强度，整数是 token 预算，对象可以再带私有字段 body。
          // auto 是保留档位：什么都不发，由服务端按模型默认处理；没写 default 时启动就在 auto。
          // DeepSeek 思考默认开启、强度 high；关闭要用它私有的 thinking 开关。
          "effort": {
            "levels": {
              "off": { "body": { "thinking": { "type": "disabled" } } },
              "low": "low",
              "high": "high",
              "max": "max"
            }
          }
        }
      }
    },

    // DeepSeek 同一个 Key 也支持 Responses 与 Anthropic Messages 协议。
    "deepseek-responses": {
      "protocol": "openai-responses",
      "baseUrl": "https://api.deepseek.com",
      "apiKeyEnv": "DEEPSEEK_API_KEY",
      "apiKey": "",
      "models": {
        "deepseek-flash": {
          "contextWindow": 1000000,
          "maxOutput": 384000,
          "tools": true,
          "vision": true,
          // Responses 协议用 reasoning.effort，none 表示关闭思考。
          // summary 设为 false：不要求返回思考摘要（不是所有兼容服务都认这个参数）。
          "effort": {
            "summary": false,
            "levels": { "off": "none", "low": "low", "high": "high", "max": "max" }
          }
        }
      }
    },

    "deepseek-anthropic": {
      "protocol": "anthropic-messages",
      "baseUrl": "https://api.deepseek.com/anthropic/v1",
      "apiKeyEnv": "DEEPSEEK_API_KEY",
      "apiKey": "",
      "models": {
        "deepseek-flash": {
          "contextWindow": 1000000,
          "maxOutput": 384000,
          "tools": true,
          "vision": true,
          // DeepSeek 的 Anthropic 入口用 thinking.type=enabled/disabled 开关思考、output_config.effort 调强度。
          // 预算 0 发送 thinking.type=disabled；其余档位用 body 把 thinking 改成 enabled。
          "effort": {
            "levels": {
              "off": 0,
              "low": { "effort": "low", "body": { "thinking": { "type": "enabled" } } },
              "high": { "effort": "high", "body": { "thinking": { "type": "enabled" } } },
              "max": { "effort": "max", "body": { "thinking": { "type": "enabled" } } }
            }
          }
        }
      }
    },

    "openai": {
      "protocol": "openai-chat",
      "baseUrl": "https://api.openai.com/v1",
      "apiKeyEnv": "OPENAI_API_KEY",
      "models": {
        "gpt-4o-mini": {
          "contextWindow": 128000,
          "maxOutput": 16384,
          "tools": true,
          "vision": true
        }
      }
    },

    // 同一个 OpenAI 账号也可以走 Responses 协议。
    "openai-responses": {
      "protocol": "openai-responses",
      "baseUrl": "https://api.openai.com/v1",
      "apiKeyEnv": "OPENAI_API_KEY",
      "models": {
        "gpt-5": {
          "contextWindow": 400000,
          "maxOutput": 32768,
          "tools": true,
          "vision": true,
          // 数组写法：档位名就是 reasoning.effort 的取值。
          "effort": { "levels": ["minimal", "low", "medium", "high"] }
        }
      }
    },

    // Anthropic Messages 协议（POST {baseUrl}/messages），baseUrl 需带 /v1。
    "anthropic": {
      "protocol": "anthropic-messages",
      "baseUrl": "https://api.anthropic.com/v1",
      "apiKeyEnv": "ANTHROPIC_API_KEY",
      "models": {
        "claude-sonnet-5-5": {
          "contextWindow": 200000,
          "maxOutput": 8192,
          "tools": true,
          "vision": true,
          // Claude 4.6 起用 thinking.type=adaptive + output_config.effort；新模型已不接受 budget_tokens。
          // 老模型（Haiku 4.5 等）改用预算写法，例如 "levels": { "off": 0, "low": 2048, "high": 16000 }。
          "effort": { "levels": ["low", "medium", "high", "xhigh", "max"] }
        }
      }
    },

    // Google Gemini 协议（POST {baseUrl}/models/{模型}:streamGenerateContent）。
    // 直连是 https://generativelanguage.googleapis.com/v1beta。
    "google": {
      "protocol": "google-generate",
      "baseUrl": "https://generativelanguage.googleapis.com/v1beta",
      "apiKeyEnv": "GEMINI_API_KEY",
      "models": {
        "gemini-2.5-pro": {
          "contextWindow": 1048576,
          "maxOutput": 65536,
          "tools": true,
          "vision": true,
          // Gemini 2.5 用 thinkingBudget（token 数，-1 动态，Flash 可用 0 关闭）；
          // Gemini 3 起改用 thinkingLevel，写成字符串即可，例如 "levels": ["low", "high"]。
          "effort": {
            "levels": { "low": 1024, "medium": 8192, "high": 24576, "max": 32768 }
          }
        }
      }
    }
  },

  "shell": {
    // 留空则自动探测；Windows 下可填 Git Bash / PowerShell 的绝对路径。
    "bashPath": "",
    "powershellPath": ""
  }
}
