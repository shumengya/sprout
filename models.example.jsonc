// Sprout 模型配置（JSONC：支持 // 和 /* */ 注释，以及尾逗号）。
// 修改后需要重启 sprout 才会生效。
{
  // 默认使用的模型，格式为 "provider名/模型名"，两边都必须在下面定义过。
  "default": "deepseek/deepseek-flash",

  "providers": {
    "deepseek": {
      // 协议：openai-chat、openai-responses、anthropic-messages、google-generate。
      "protocol": "openai-chat",
      "baseUrl": "https://api.deepseek.com",
      // API Key 优先读环境变量 apiKeyEnv，环境变量没设置时才使用 apiKey。
      // 直接写 apiKey 时，请确保这个文件只在本机使用，不要提交到仓库。
      "apiKeyEnv": "DEEPSEEK_API_KEY",
      "apiKey": "",
      "models": {
        "deepseek-flash": {
          "contextWindow": 1000000,
          "maxOutput": 384000,
          "tools": true
        }
      }
    },

    // DeepSeek 同一个 Key 也支持 Responses 与 Anthropic Messages 协议。
    "deepseek-responses": {
      "protocol": "openai-responses",
      "baseUrl": "https://api.deepseek.com",
      "apiKeyEnv": "DEEPSEEK_API_KEY",
      "apiKey": "",
      "models": {
        "deepseek-flash": {
          "contextWindow": 1000000,
          "maxOutput": 384000,
          "tools": true
        }
      }
    },

    "deepseek-anthropic": {
      "protocol": "anthropic-messages",
      "baseUrl": "https://api.deepseek.com/anthropic/v1",
      "apiKeyEnv": "DEEPSEEK_API_KEY",
      "apiKey": "",
      "models": {
        "deepseek-flash": {
          "contextWindow": 1000000,
          "maxOutput": 384000,
          "tools": true
        }
      }
    },

    "openai": {
      "protocol": "openai-chat",
      "baseUrl": "https://api.openai.com/v1",
      "apiKeyEnv": "OPENAI_API_KEY",
      "models": {
        "gpt-4o-mini": {
          "contextWindow": 128000,
          "maxOutput": 16384,
          "tools": true
        }
      }
    },

    // 同一个 OpenAI 账号也可以走 Responses 协议。
    "openai-responses": {
      "protocol": "openai-responses",
      "baseUrl": "https://api.openai.com/v1",
      "apiKeyEnv": "OPENAI_API_KEY",
      "models": {
        "gpt-5": {
          "contextWindow": 400000,
          "maxOutput": 32768,
          "tools": true
        }
      }
    },

    // Anthropic Messages 协议（POST {baseUrl}/messages），baseUrl 需带 /v1。
    "anthropic": {
      "protocol": "anthropic-messages",
      "baseUrl": "https://api.anthropic.com/v1",
      "apiKeyEnv": "ANTHROPIC_API_KEY",
      "models": {
        "claude-sonnet-5-5": {
          "contextWindow": 200000,
          "maxOutput": 8192,
          "tools": true
        }
      }
    },

    // Google Gemini 协议（POST {baseUrl}/models/{模型}:streamGenerateContent）。
    // 直连是 https://generativelanguage.googleapis.com/v1beta。
    "google": {
      "protocol": "google-generate",
      "baseUrl": "https://generativelanguage.googleapis.com/v1beta",
      "apiKeyEnv": "GEMINI_API_KEY",
      "models": {
        "gemini-2.5-pro": {
          "contextWindow": 1048576,
          "maxOutput": 65536,
          "tools": true
        }
      }
    }
  },

  "shell": {
    // 留空则自动探测；Windows 下可填 Git Bash / PowerShell 的绝对路径。
    "bashPath": "",
    "powershellPath": ""
  }
}
