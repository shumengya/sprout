// Sprout 状态栏配置（JSONC：支持 // 和 /* */ 注释，以及尾逗号）。
//
// 每条可以写：
//   name    项目名（见下面列出的全部）；写错会在启动时报错，避免拼错后悄悄少了一项
//   line    显示在第几行：1-3，默认取程序内置的行号
//   color   颜色：256 色编号（如 "75"）、#RRGGBB，或 red / cyan 这类颜色名；不写用内置颜色
//   enable  是否显示，默认 true。改成 false 与本条删掉效果相同
//
// 一行里各项的先后就是这里数组的顺序；某项这一行放不下时整项被截掉，不会换行。
// 修改后需要重启 sprout 才会生效。
{
  "items": [
    // 第一行：工作目录、本会话概况、整机资源
    { "name": "路径" },
    { "name": "对话轮次" },
    { "name": "耗时" },
    { "name": "内存" },
    { "name": "CPU" },

    // 第二行：token 用量、花费、上下文、模型
    { "name": "输入" },
    { "name": "输出" },
    { "name": "缓存" },
    { "name": "花费" },
    { "name": "上下文" },
    { "name": "模型" },
    { "name": "思考强度" },

    // 第三行：当前状态、扩展能力、Git
    { "name": "状态" },
    { "name": "速度" },
    { "name": "压缩" },
    { "name": "MCP" },
    { "name": "插件" },
    { "name": "技能" },
    { "name": "工具" },
    { "name": "Git" }
  ]
}
